{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "vitest",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/components/hex-listbox.ts",
    "src/components/hex-option.ts",
    "src/components/hex-autocomplete.ts",
    "src/components/hex-select.ts",
    "src/shared/form-element.ts",
    "src/shared/field-element.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
