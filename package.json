{
  "name": "@clynamic/hexagonal",
  "version": "0.3.1",
  "publishConfig": {
    "registry": "https://npm.clynamic.net/"
  },
  "description": "A design for a blue honeycomb world.",
  "homepage": "https://clragon.github.io/hexagonal/",
  "repository": {
    "type": "git",
    "url": "https://github.com/clragon/hexagonal.git"
  },
  "license": "UNLICENSED",
  "author": "binaryfloof",
  "type": "module",
  "main": "dist/hexagonal.js",
  "module": "dist/hexagonal.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/hexagonal.js"
    },
    "./tokens.css": "./dist/hexagonal-tokens.css",
    "./preflight.css": "./dist/hexagonal-preflight.css",
    "./fonts.css": "./dist/hexagonal-fonts.css"
  },
  "files": [
    "dist/hexagonal.js",
    "dist/hexagonal.js.map",
    "dist/hexagonal.min.js",
    "dist/hexagonal-tokens.css",
    "dist/hexagonal-fonts.css",
    "dist/hexagonal-preflight.css",
    "dist/types"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.book.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "verify": "npm run fmt:check && npm run lint && npm run typecheck && npm run preflight:check",
    "preflight": "node scripts/preflight.mjs",
    "preflight:check": "node scripts/preflight.mjs --check",
    "hero": "node scripts/hero.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:preflight": "npm run build && vitest run --config vitest.preflight.config.ts",
    "test:all": "npm run test && npm run test:preflight",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.9.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "esbuild": "^0.28.0",
    "marked": "^18.0.3",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "1.60.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
