{
  "name": "@clynamic/hexagonal",
  "version": "0.1.0",
  "description": "Hexagonal Design System as CDN-able web components",
  "license": "UNLICENSED",
  "author": "binaryfloof",
  "type": "module",
  "main": "dist/hexagonal.js",
  "module": "dist/hexagonal.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/hexagonal.js"
    },
    "./fonts.css": "./dist/hexagonal-fonts.css"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "check": "yarn fmt:check && yarn lint && yarn typecheck",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "marked": "^18.0.3",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3"
  }
}
